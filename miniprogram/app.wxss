/* 全局样式 / Global Styles */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
  font-size: 16px;
  color: #333;
  box-sizing: border-box;
}

/* 通用按钮 / Common Button */
.btn-primary {
  background-color: #4A90D9;
  color: #fff;
  border: none;
  border-radius: 12px;
  padding: 16px 32px;
  font-size: 18px;
  font-weight: 600;
  text-align: center;
  display: block;
  width: 80%;
  margin: 20px auto;
  box-shadow: 0 4px 12px rgba(74, 144, 217, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-secondary {
  background-color: #fff;
  color: #4A90D9;
  border: 2px solid #4A90D9;
  border-radius: 12px;
  padding: 16px 32px;
  font-size: 18px;
  font-weight: 600;
  text-align: center;
  display: block;
  width: 80%;
  margin: 20px auto;
}

.btn-secondary:active {
  background-color: #f0f6ff;
}

/* 通用容器 / Common Container */
.container {
  padding: 20px;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片样式 / Card Style */
.card {
  background: #fff;
  border-radius: 16px;
  padding: 24px;
  margin: 16px 0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
}