/* 学习页样式 / Study Page Styles */

.container {
  padding: 20px;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 顶部清空错词按钮 / Top Clear Mistakes Button */
.top-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8px;
}

.clear-mistakes-btn {
  font-size: 14px;
  color: #E74C3C;
  padding: 8px 16px;
  border: 1px solid #E74C3C;
  border-radius: 8px;
}

/* 进度条 / Progress Bar */
.progress-bar {
  width: 100%;
  height: 6px;
  background: #e0e0e0;
  border-radius: 3px;
  margin-bottom: 8px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #357ABD);
  border-radius: 3px;
  transition: width 0.3s ease;
}

.progress-text {
  text-align: center;
  font-size: 14px;
  color: #888;
  margin-bottom: 24px;
}

/* 词汇卡片 / Word Card */
.word-card {
  background: #fff;
  border-radius: 20px;
  padding: 40px 24px;
  text-align: center;
  box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  margin-bottom: 20px;
}

.chinese-word {
  font-size: 48px;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 12px;
  line-height: 1.2;
}

.pinyin {
  font-size: 20px;
  color: #888;
  font-style: italic;
}

.sentence {
  font-size: 15px;
  color: #aaa;
  margin-top: 10px;
  line-height: 1.5;
  font-style: normal;
}

.pos-text {
  font-size: 13px;
  color: #4A90D9;
  margin-top: 6px;
  font-style: italic;
}

/* 提示 / Hint */
.hint {
  text-align: center;
  color: #999;
  font-size: 14px;
  margin-bottom: 16px;
}

/* 选项列表 / Options List */
.options-list {
  display: flex;
  flex-direction: column;
}

.option + .option {
  margin-top: 12px;
}

.option {
  display: flex;
  align-items: center;
  padding: 16px 20px;
  background: #fff;
  border-radius: 14px;
  border: 2px solid #e8e8e8;
  transition: all 0.25s;
  box-shadow: 0 2px 8px rgba(0,0,0,0.03);
}

.option:active {
  transform: scale(0.98);
}

.option.correct {
  border-color: #5CB85C;
  background: #f0faf0;
}

.option.wrong {
  border-color: #E74C3C;
  background: #fef0ef;
}

.option-letter {
  width: 32px;
  height: 32px;
  background: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  color: #666;
  margin-right: 14px;
  flex-shrink: 0;
}

.option.correct .option-letter {
  background: #5CB85C;
  color: #fff;
}

.option.wrong .option-letter {
  background: #E74C3C;
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 17px;
  color: #333;
}

.option-icon {
  font-size: 20px;
  font-weight: 700;
  margin-left: 8px;
}

.option.correct .option-icon {
  color: #5CB85C;
}

.option.wrong .option-icon {
  color: #E74C3C;
}

/* 正确反馈 / Correct Feedback */
.feedback {
  text-align: center;
  padding: 16px;
  font-size: 18px;
  font-weight: 600;
  margin-top: 16px;
  border-radius: 12px;
}

.correct-feedback {
  color: #5CB85C;
  background: #f0faf0;
}

/* 结果卡片 / Result Card */
.result-card {
  background: #fff;
  border-radius: 20px;
  padding: 40px 24px;
  text-align: center;
  box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  margin-top: 20px;
}

.result-icon {
  font-size: 64px;
  margin-bottom: 12px;
}

.result-title {
  font-size: 28px;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 8px;
}

.result-subtitle {
  font-size: 15px;
  color: #888;
  margin-bottom: 24px;
}

.result-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30px;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 28px;
  font-weight: 700;
  color: #2c3e50;
}

.stat-value.correct {
  color: #5CB85C;
}

.stat-value.wrong {
  color: #E74C3C;
}

.stat-label {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

.btn-primary {
  width: 100%;
  margin: 12px 0;
}

.btn-secondary {
  width: 100%;
  margin: 12px 0;
}