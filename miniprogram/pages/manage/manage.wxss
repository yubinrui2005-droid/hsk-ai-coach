.container {
  padding: 20px;
  min-height: 100vh;
  box-sizing: border-box;
}

.picker-section {
  width: 100%;
  margin-bottom: 14px;
  position: relative;
}

.picker-label {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px 24px;
  background: #fff;
  border-radius: 12px;
  font-size: 15px;
  color: #555;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.arrow {
  font-size: 12px;
  color: #4A90D9;
  margin-left: 8px;
}

.picker-options {
  display: none;
  flex-direction: row;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 10px;
}

.picker-options.show {
  display: flex;
}

.picker-option {
  padding: 8px 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  color: #555;
  box-shadow: 0 2px 6px rgba(0,0,0,0.04);
  margin: 3px 6px;
}

.picker-option.active {
  background: #4A90D9;
  color: #fff;
}

.stats {
  font-size: 13px;
  color: #888;
  text-align: center;
  margin-bottom: 14px;
}

.word-list {
  display: flex;
  flex-direction: column;
}

.word-row {
  background: #fff;
  border-radius: 12px;
  padding: 14px 16px;
  box-shadow: 0 1px 6px rgba(0,0,0,0.04);
  margin-bottom: 10px;
}

.word-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.word-info {
  flex: 1;
  min-width: 0;
}

.word-text {
  font-size: 18px;
  font-weight: 700;
  color: #2c3e50;
}

.word-pinyin {
  font-size: 13px;
  color: #999;
  margin-left: 8px;
}

.word-answer {
  font-size: 13px;
  color: #4A90D9;
  margin-top: 4px;
}

.word-sentence {
  font-size: 13px;
  color: #aaa;
  margin-top: 4px;
  line-height: 1.4;
}

.word-pos {
  font-size: 12px;
  color: #4A90D9;
  margin-top: 3px;
  font-style: italic;
}

.word-meta {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.level-badge {
  font-size: 11px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 6px;
  background: #e8f0fe;
  color: #4A90D9;
  margin-right: 10px;
}

.word-actions {
  display: flex;
}

.action-btn {
  font-size: 20px;
  padding: 4px 8px;
  line-height: 1;
}

.edit-form {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid #f0f0f0;
}

.form-input {
  width: 100%;
  height: 40px;
  background: #f5f5f5;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 14px;
  margin-bottom: 8px;
  box-sizing: border-box;
}

.form-input.answer-input {
  background: #f0f6ff;
}

.form-actions {
  display: flex;
  margin-top: 4px;
}

.form-save {
  flex: 1;
  padding: 10px 0;
  background: #4A90D9;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  border-radius: 8px;
  border: none;
  margin-right: 10px;
}

.form-save::after { border: none; }

.form-cancel {
  flex: 1;
  padding: 10px 0;
  background: #f5f5f5;
  color: #888;
  font-size: 14px;
  font-weight: 600;
  border-radius: 8px;
  border: none;
}

.form-cancel::after { border: none; }

.add-bar {
  margin: 16px 0;
  display: flex;
  gap: 10px;
}

.add-btn {
  flex: 1;
  padding: 12px 0;
  background: #5CB85C;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  border-radius: 12px;
  border: none;
}

.add-btn::after { border: none; }

.export-btn {
  flex: 1;
  padding: 12px 0;
  background: #FF9800;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  border-radius: 12px;
  border: none;
}

.export-btn::after { border: none; }

.back-link {
  text-align: center;
  padding: 16px;
  font-size: 15px;
  color: #888;
}
