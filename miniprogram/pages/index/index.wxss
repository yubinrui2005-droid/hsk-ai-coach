/* 首页样式 / Home Page Styles */

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 32px;
  margin-top: 20px;
}

.logo {
  font-size: 72px;
  margin-bottom: 12px;
}

.title {
  font-size: 32px;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 8px;
}

.subtitle {
  font-size: 14px;
  color: #999;
}

/* 通用选择器样式 / Common Picker Styles */
.picker-section {
  width: 100%;
  margin-bottom: 12px;
  position: relative;
}

.picker-label {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px 24px;
  background: #fff;
  border-radius: 12px;
  font-size: 16px;
  color: #555;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.arrow {
  font-size: 12px;
  color: #4A90D9;
  margin-left: 8px;
}

.picker-options {
  display: none;
  flex-direction: row;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 12px;
}

.picker-options.show {
  display: flex;
}

.picker-option {
  padding: 10px 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  color: #555;
  box-shadow: 0 2px 6px rgba(0,0,0,0.04);
  transition: all 0.2s;
  margin: 3px 6px;
}

.picker-option.active {
  background: #4A90D9;
  color: #fff;
}

/* 按钮 / Buttons */
.buttons {
  width: 100%;
  margin-top: 10px;
}

.btn-primary {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin: 16px 0;
  padding: 20px;
  background: #fff;
  border: none;
  border-radius: 16px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  font-size: inherit;
  line-height: 1.5;
}

.btn-primary::after {
  border: none;
}

.study-btn {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  color: #fff;
}

.mistake-btn {
  background: linear-gradient(135deg, #E74C3C, #C0392B);
  color: #fff;
}

.review-btn {
  background: linear-gradient(135deg, #5CB85C, #449D44);
  color: #fff;
}

.add-word-btn {
  background: linear-gradient(135deg, #F39C12, #E67E22);
  color: #fff;
}

.manage-btn {
  background: linear-gradient(135deg, #8E44AD, #6C3483);
  color: #fff;
}

.btn-icon {
  font-size: 36px;
  margin-bottom: 6px;
}

.btn-text {
  font-size: 22px;
  font-weight: 700;
}

.btn-desc {
  font-size: 13px;
  opacity: 0.8;
  margin-top: 4px;
}

/* 设置入口 / Settings Link */
.settings-link {
  margin-top: 30px;
  padding: 12px 24px;
  font-size: 15px;
  color: #888;
}
