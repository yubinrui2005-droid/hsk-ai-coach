.container {
  padding: 20px;
  min-height: 100vh;
  box-sizing: border-box;
}

.picker-section {
  width: 100%;
  margin-bottom: 14px;
  position: relative;
}

.picker-label {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px 24px;
  background: #fff;
  border-radius: 12px;
  font-size: 15px;
  color: #555;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.arrow {
  font-size: 12px;
  color: #4A90D9;
  margin-left: 8px;
}

.picker-options {
  display: none;
  flex-direction: row;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 10px;
}

.picker-options.show {
  display: flex;
}

.picker-option {
  padding: 8px 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  color: #555;
  box-shadow: 0 2px 6px rgba(0,0,0,0.04);
  margin: 3px 6px;
}

.picker-option.active {
  background: #4A90D9;
  color: #fff;
}

.form-section {
  background: #fff;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
  margin-bottom: 20px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 16px;
}

.input-group {
  margin-bottom: 12px;
}

.input {
  width: 100%;
  height: 44px;
  background: #f5f5f5;
  border-radius: 10px;
  padding: 0 14px;
  font-size: 15px;
  box-sizing: border-box;
}

.input::placeholder {
  color: #bbb;
}

.options-label {
  font-size: 13px;
  color: #999;
  margin-bottom: 10px;
  margin-top: 8px;
}

.option-row {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  padding: 8px 6px;
  border-radius: 12px;
  transition: background 0.2s;
}

.option-row.selected {
  background: #f0f6ff;
}

.radio {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid #d0d0d0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  color: #fff;
  margin-right: 10px;
  flex-shrink: 0;
  transition: all 0.2s;
}

.radio.checked {
  background: #5CB85C;
  border-color: #5CB85C;
}

.option-input {
  flex: 1;
  height: 44px;
  background: #f5f5f5;
  border-radius: 10px;
  padding: 0 14px;
  font-size: 15px;
  box-sizing: border-box;
}

.option-input.answer-input {
  background: #eaf5ea;
  border: 1px solid #5CB85C;
}

.option-input::placeholder {
  color: #bbb;
}

.submit-btn {
  width: 100%;
  margin-top: 18px;
  background: #4A90D9;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  border-radius: 12px;
  border: none;
  padding: 12px 0;
}

.submit-btn::after {
  border: none;
}

.list-section {
  background: #fff;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
  margin-bottom: 20px;
}

.word-list {
  display: flex;
  flex-direction: column;
}

.word-item + .word-item {
  margin-top: 12px;
}

.word-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 14px;
  background: #fafafa;
  border-radius: 10px;
}

.word-main {
  font-size: 17px;
  font-weight: 600;
  color: #2c3e50;
}

.word-pinyin {
  font-size: 13px;
  color: #999;
  font-weight: 400;
  margin-left: 8px;
}

.word-answer {
  font-size: 13px;
  color: #4A90D9;
  margin-top: 4px;
}

.word-sentence {
  font-size: 13px;
  color: #aaa;
  margin-top: 4px;
  line-height: 1.4;
}

.word-pos {
  font-size: 12px;
  color: #4A90D9;
  margin-top: 3px;
  font-style: italic;
}

.delete-btn {
  font-size: 13px;
  color: #E74C3C;
  padding: 6px 12px;
  border: 1px solid #E74C3C;
  border-radius: 8px;
  flex-shrink: 0;
}

.empty-hint {
  text-align: center;
  color: #bbb;
  font-size: 14px;
  padding: 40px 0;
}

.back-link {
  text-align: center;
  padding: 16px;
  font-size: 15px;
  color: #888;
}
